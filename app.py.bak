# 9) Partners & Drive Img
# =========================
def drive_img(url: str, width: int = 800) -> str:
    if not url:
        return ""
    fid = ""
    patterns = [
        r"/file/d/([^/]+)",
        r"[?&]id=([^&]+)",
        r"drive\.google\.com/uc\?export=.*?&id=([^&]+)"
    ]
    for p in patterns:
        m = re.search(p, str(url))
        if m:
            fid = m.group(1)
            break
    if not fid and len(str(url)) > 20 and "/" not in str(url):
        fid = str(url)
    return f"https://drive.google.com/thumbnail?id={fid}&sz=w{width}" if fid else str(url)

@st.cache_data(ttl=300)
def load_all_partners():
    conn = get_conn()
    df = pd.concat([gs_read(conn, "partners_master", 0), gs_read(conn, "partners_team", 0)], ignore_index=True)
    df.columns = df.columns.str.strip().str.lower()
    if "ref" in df.columns:
        df["ref"] = df["ref"].astype(str).map(norm_ref)
    return df

try:
    df_all = load_all_partners()
    ref_input = norm_ref(get_qp("ref", "master"))

    if ("ref" in df_all.columns) and (ref_input in df_all["ref"].astype(str).map(norm_ref).values):
        partner = df_all[df_all["ref"] == ref_input].iloc[0].to_dict()
    elif ("ref" in df_all.columns) and ("master" in df_all["ref"].values):
        partner = df_all[df_all["ref"] == "master"].iloc[0].to_dict()
    else:
        partner = df_all.iloc[0].to_dict()

    p_img = drive_img(partner.get("img_url", ""))
    LINE_ADD_URL = partner.get("line_search_id", "")
    if LINE_ADD_URL and not str(LINE_ADD_URL).startswith("http"):
        LINE_ADD_URL = f"https://line.me/R/ti/p/{quote(str(LINE_ADD_URL))}"
except Exception:
    partner = {"name": "顧問", "ref": "master"}
    LINE_ADD_URL = ""
    p_img = ""

def log_event(conn, event_name: str, extra: Dict[str, Any]):
    try:
        row = {
            "ts": tz8_now().strftime("%Y-%m-%d %H:%M:%S"),
            "event": event_name,
            "quiz_id": st.session_state.quiz_id,
            "ref": partner.get("ref", ""),
            "funnel": FUNNEL_TAG,
            "mode": MODE,
            **{f"x_{k}": safe_str(v) for k, v in (extra or {}).items()}
        }
        # ✅ events 不去重
        gs_append_row(conn, EVENTS_SHEET, row, dedupe_key=None)
    except Exception:
        pass

