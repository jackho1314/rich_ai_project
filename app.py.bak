                log_event(get_conn(), "start_quiz", {"name": name})
            except Exception:
                pass
            st.rerun()

def page_quiz():
    show_partner_card()
    render_sticky_cta(label="加顧問 LINE (中途疑問)")

    q_data = QUIZ["questions"]
    total = len(q_data)
    step = st.session_state.step

    st.progress((step - 1) / total)
    st.markdown(f"### 第 {step} 題 / 共 {total} 題")

    q_item = q_data[step - 1]
    if isinstance(q_item, tuple):
        qid, qtxt, opts = q_item
        sec = ""
    else:
        qid, qtxt, opts = q_item["id"], q_item["text"], q_item["options"]
        sec = q_item.get("section", "")

    if sec:
        st.caption(sec)
    st.markdown(f"#### {qtxt}")

    labels = [o[0] for o in opts]
    vals = [o[1] for o in opts]

    prev_val = st.session_state.answers_map.get(step)
    idx = vals.index(prev_val) if prev_val in vals else 0

    choice_label = st.radio("請選擇：", labels, index=idx, key=f"q_{step}")

    c1, c2 = st.columns(2)
    with c1:
        if st.button("上一題") and step > 1:
            st.session_state.step -= 1
            st.rerun()
    with c2:
        btn_txt = "下一題" if step < total else "查看結果"
        if st.button(btn_txt):
            sel_val = vals[labels.index(choice_label)]
            st.session_state.answers_map[step] = sel_val

            if step < total:
                st.session_state.step += 1
                st.rerun()
            else:
                with st.spinner("📊 AI 正在運算您的風格數據..."):
                    time.sleep(0.9)
                    st.session_state.page = "result"
                    st.rerun()

def compute_health_score_and_flags(answers_map: Dict[int, Any], q_data: List[Dict[str, Any]]):
    """只計算 scale，flag 不算入總分"""
    scale_steps = []
    flag_steps = []
    for i, q in enumerate(q_data, start=1):
        if q.get("qtype") == "scale":
            scale_steps.append(i)
        elif q.get("qtype") == "flag":
            flag_steps.append(i)

    score = sum(int(answers_map.get(i, 0) or 0) for i in scale_steps)
    max_s = len(scale_steps) * 3
    red_flags = [i for i in flag_steps if int(answers_map.get(i, 0) or 0) == 1]
    return score, max_s, red_flags

def page_result():
    show_partner_card()
    render_sticky_cta(label="➕ 加顧問 LINE (領取完整報告)")

    answers = st.session_state.answers_map
    st.markdown(f'<div class="hero-title">{st.session_state.u_name} 的分析報告</div>', unsafe_allow_html=True)

    primary = ""
    secondary = ""
    res_text = ""
    band = ""
    desc = ""
    score = 0
    max_s = 0
    red_flags = []

    if QUIZ["kind"] == "type":
        st.balloons()
        counts = Counter(answers.values())
        primary, secondary = pick_primary_secondary(counts)
        res_text = DB_P.get(primary, primary)
        if secondary:
            res_text += f" x {DB_P.get(secondary, secondary)}"

        st.markdown(f"### ✅ 你的風格：{res_text}")
        st.markdown("#### 📊 五力分析雷達圖")
        render_radar_chart(answers)

        st.markdown("---")
        st.info("💡 每個風格都有優勢，重點是怎麼用。請選擇下方的興趣，讓顧問告訴你這張牌怎麼打最順。")
    else:
        q_data = QUIZ["questions"]
        score, max_s, red_flags = compute_health_score_and_flags(answers, q_data)

        if score < 8:
            band, desc = "🟢 身體穩健", "底子很好，繼續保持！"
        elif score < 16:
            band, desc = "🟡 開始扣利息", "有點累了，要注意休息。"
        else:
            band, desc = "🔴 嚴重超載", "該停下來檢修了，別硬撐。"

        st.markdown(f"### ✅ 結果：{band} ({score}/{max_s})")
        st.write(desc)
        st.progress(min(score / max_s, 1.0))

        if red_flags:
            st.error("🚩 警示：您勾選了紅旗題，建議優先諮詢專業醫師。")

    # 興趣選擇（必填）
    st.markdown("### 🎯 下一步你對什麼有興趣？")
    interest_sel = st.selectbox(
        "請選擇（必填）",
        ["請選擇"] + QUIZ.get("interest_options", []),
        key="interest_sel",
        disabled=st.session_state.notified
    )

    interest = interest_sel
    if interest_sel == "其他（可填）" and not st.session_state.notified:
        st.session_state.u_interest_other = st.text_input("其他請填寫", st.session_state.u_interest_other)
        if st.session_state.u_interest_other.strip():
            interest = f"其他：{st.session_state.u_interest_other.strip()}"

    # 觸發寫入 + 推播
    if interest != "請選擇" and not st.session_state.notified:
        ref_resolved = safe_str(partner.get("ref", "master"))
        state_txt = safe_str(st.session_state.u_state) if QUIZ.get("needs_state") else ""
        result_txt = res_text if QUIZ["kind"] == "type" else band

        lead_id = compute_lead_id(
            QUIZ["id"], QUIZ_VERSION, ref_resolved,
            st.session_state.u_name, state_txt, interest,
            primary, secondary, FUNNEL_TAG, MODE
        )

        push_msg = f"""👨‍💼 顧問：{partner.get("name")}
✅ 結果：{result_txt}
🎯 興趣：{interest}
—
👤 客戶：{st.session_state.u_name}
🕒 時間：{tz8_now().strftime('%Y-%m-%d %H:%M')}
🆔 ID：{lead_id}"""

        try:
            conn = get_conn()

            answers_raw = ""
            if QUIZ["kind"] == "type":
                answers_raw = "".join([safe_str(answers.get(i, "")) for i in range(1, 11)])
            else:
                answers_raw = ",".join([safe_str(answers.get(i, "")) for i in range(1, len(QUIZ["questions"]) + 1)])

            lead_row = {
                "ts": tz8_now().strftime("%Y-%m-%d %H:%M:%S"),
                "lead_id": lead_id,
                "quiz_id": QUIZ["id"],
                "quiz_version": QUIZ_VERSION,
                "ref": ref_resolved,
                "funnel": FUNNEL_TAG,
                "mode": MODE,
                "partner_name": safe_str(partner.get("name")),
                "client_name": safe_str(st.session_state.u_name),
                "state": state_txt,
                "interest": interest,
                "primary": primary,
                "secondary": secondary,
                "result_text": result_txt,
                "health_score": score if QUIZ["kind"] == "score" else "",
                "health_max": max_s if QUIZ["kind"] == "score" else "",
                "health_red_flags": ",".join(map(str, red_flags)) if red_flags else "",
                "answers_raw": answers_raw,
            }

            wrote = gs_append_row(conn, LEADS_SHEET, lead_row, dedupe_key="lead_id")
            sent = send_line_push(push_msg)

            st.session_state.notified = True
            st.session_state.notified_lead_id = lead_id

            if wrote and sent:
                st.success("✅ 報告已生成並通知顧問！")
            elif wrote and not sent:
                st.success("✅ 報告已寫入（LINE 未設定，僅顯示預覽）")
            elif (not wrote) and sent:
                st.success("✅ 已通知顧問（Sheet 可能已存在相同 ID）")
            else:
                st.info("✅ 已生成（Sheet/LINE 皆未送出，請檢查 secrets 設定）")

            try:
                log_event(conn, "finish_result", {"lead_id": lead_id, "sent": sent, "wrote": wrote})
            except Exception:
                pass

        except Exception as e:
            st.error("連線錯誤，請截圖給顧問")
            if DEBUG:
                st.sidebar.exception(e)

        st.code(push_msg, language="text")
        st.caption("👆 以上是顧問收到的訊息預覽")

    if st.button("重新測驗"):
        reset_quiz_progress(False)
        st.rerun()

# =========================
# Router
# =========================
if st.session_state.page == "intro":
    page_intro()
elif st.session_state.page == "quiz":
    page_quiz()
else:
    page_result()
