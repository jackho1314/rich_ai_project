    st.markdown("---")

    if cur_id == "wealth":
        st.markdown(
            """
            <div class="glass-card">
              <div style="font-size:1.1rem;font-weight:bold;margin-bottom:8px;">🎯 AI 財富測驗</div>
              <div style="line-height:1.6;color:#ddd;">
                這不是算命，而是數據分析。你不用變厲害才開始，你只要先看懂自己的風格，路就會變簡單。
              </div>
            </div>
            """, unsafe_allow_html=True
        )
    else:
        st.markdown(
            """
            <div class="glass-card">
              <div style="font-size:1.1rem;font-weight:bold;margin-bottom:8px;">👵 隱形利息健康對帳</div>
              <div style="line-height:1.6;color:#ddd;">
                健康像存摺，疲憊像利息。透過 8+2 題快速對帳，看看你的體力有沒有透支？
              </div>
            </div>
            """, unsafe_allow_html=True
        )

    name = st.text_input("如何稱呼你？", value=st.session_state.u_name)

    if QUIZ.get("needs_state"):
        state_opts = ["請選擇", "我有危機感/想找方向", "我想顧好健康", "我想提升財富", "我想突破事業", "我想經營家庭", "我想拿回時間", "其他（可填）"]
        st.markdown("### 你目前最在意的是？")
        s_sel = st.selectbox("請選擇（必填）", state_opts, key="state_sel")
        if s_sel == "其他（可填）":
            st.session_state.u_state_other = st.text_input("其他請填寫", st.session_state.u_state_other)
            st.session_state.u_state = f"其他：{st.session_state.u_state_other}"
        elif s_sel != "請選擇":
            st.session_state.u_state = s_sel

    if st.button("開始測驗 🚀", key="start_btn"):
        if not name.strip():
            st.warning("請輸入稱呼")
            return
