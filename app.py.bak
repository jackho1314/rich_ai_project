# 7) Data Connections (GSheets)
# =========================
DEFAULT_SHEET_URL = "https://docs.google.com/spreadsheets/d/1GxpOmk108RM8wd9lvrQSpngTm5_KWpKkF31bbXjZKv8/edit"
SPREADSHEET_URL = (sget(st.secrets, "connections", "gsheets", "spreadsheet") or DEFAULT_SHEET_URL)

def get_conn():
    if GSheetsConnection is None:
        st.error("❌ 找不到 GSheetsConnection。請確認你已安裝 st-gsheets-connection，且 secrets.toml 已設定 connections.gsheets。")
        if DEBUG and _GSHEETS_IMPORT_ERR:
            st.sidebar.write("GSheets import err:", repr(_GSHEETS_IMPORT_ERR))
        st.stop()
    return st.connection("gsheets", type=GSheetsConnection)

def gs_read(conn, worksheet, ttl=60):
    return _retry(lambda: conn.read(spreadsheet=SPREADSHEET_URL, worksheet=worksheet, ttl=ttl), name=f"read:{worksheet}")

def gs_update(conn, worksheet, data):
    return _retry(lambda: conn.update(spreadsheet=SPREADSHEET_URL, worksheet=worksheet, data=data), name=f"update:{worksheet}")

# ✅ append row（含 lead_id 去重 / 可關閉去重）
def gs_append_row(conn, worksheet: str, row: Dict[str, Any], *, dedupe_key: Optional[str] = "lead_id"):
    """
    以「讀取 -> 補欄位 -> 追加 -> update」方式模擬 append。
    - dedupe_key=None 或 "" => 不去重
    """
    df = gs_read(conn, worksheet, ttl=0)
    if df is None or df.empty:
        df = pd.DataFrame(columns=list(row.keys()))

    # 清理欄名
    df.columns = [str(c).strip() for c in df.columns]

    # 去重：同 dedupe_key 不再寫入
    if dedupe_key and (dedupe_key in df.columns) and (dedupe_key in row):
        existed = df[dedupe_key].astype(str).tolist()
        if str(row[dedupe_key]) in existed:
            return False  # 已存在

    # 補齊缺少欄位
    for k in row.keys():
        if k not in df.columns:
            df[k] = ""

    # 依 df 欄位順序塞值
    new_row = {c: "" for c in df.columns}
    for k, v in row.items():
        new_row[k] = v

    df2 = pd.concat([df, pd.DataFrame([new_row])], ignore_index=True)
    gs_update(conn, worksheet, df2)
    return True

# =========================
# 8) LINE Push（淨化推播）
# =========================
def send_line_push(message: str) -> bool:
    """
    需要在 st.secrets 設定：
    [line]
    channel_access_token = "xxxxx"
    to = "Uxxxxxxxxxxxxxxxxxxxxxxxxxxxx"  # 顧問的 userId / groupId / roomId
    """
    token = sget(st.secrets, "line", "channel_access_token", default="")
    to_id = sget(st.secrets, "line", "to", default="")
    if not token or not to_id:
        return False

    url = "https://api.line.me/v2/bot/message/push"
    headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}
    payload = {"to": to_id, "messages": [{"type": "text", "text": message[:4900]}]}
    r = requests.post(url, headers=headers, data=json.dumps(payload), timeout=10)
    return r.status_code in (200, 201)

