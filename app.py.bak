            st.warning("請選擇目前最在意的事")
            return

        with st.spinner("🔄 AI 正在初始化測驗模組..."):
            time.sleep(0.8)
            st.session_state.u_name = name
            st.session_state.page = "quiz"
            st.session_state.step = 1
