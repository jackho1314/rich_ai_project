# =========================
# 3) Retry wrapper
# =========================
def _retry(fn, *, attempts=4, base_sleep=0.5, max_sleep=3.0, name="op"):
    last = None
    for i in range(attempts):
        try:
            return fn()
        except Exception as e:
            last = e
            if i == attempts - 1:
                raise
            sleep = min(max_sleep, base_sleep * (2 ** i)) + random.random() * 0.25
            if DEBUG:
                st.sidebar.write(f"🔁 retry({name}) {i+1}/{attempts-1} -> {type(e).__name__}")
            time.sleep(sleep)
    raise last

# =========================
# 4) Logic Helpers
# =========================
TYPE_PRIORITY_DEFAULT = ["A", "B", "C", "D"]

def pick_primary_secondary(counts: Counter, type_priority: Optional[List[str]] = None) -> Tuple[str, str]:
    pr = type_priority or TYPE_PRIORITY_DEFAULT
    if not counts:
        return pr[0], ""
    max_n = max(counts.values())
    primary_candidates = [t for t, n in counts.items() if n == max_n]
    primary = next((t for t in pr if t in primary_candidates), primary_candidates[0])
    secondary_candidates = [t for t in primary_candidates if t != primary]
    secondary = next((t for t in pr if t in secondary_candidates), "") if secondary_candidates else ""
    if not secondary:
        remaining = {t: n for t, n in counts.items() if t != primary}
        if remaining:
            max_2 = max(remaining.values())
            sec_candidates = [t for t, n in remaining.items() if n == max_2]
            secondary = next((t for t in pr if t in sec_candidates), sec_candidates[0])
    return primary, secondary


def compute_lead_id(quiz_id, quiz_version, ref_resolved, client_name, state, interest,
                    primary, secondary, funnel, mode) -> str:
    base = f"{quiz_id}|{quiz_version}|{ref_resolved}|{client_name}|{state}|{interest}|{primary}|{secondary}|{funnel}|{mode}"
    return hashlib.sha256(base.encode("utf-8")).hexdigest()[:8]

