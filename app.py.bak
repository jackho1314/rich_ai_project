    {"id": "H07", "section": "第四關：體質", "text": "變天就容易感冒？", "options": HEALTH_SCALE, "qtype": "scale"},
    {"id": "H08", "section": "第四關：體質", "text": "覺得體力大不如前？", "options": HEALTH_SCALE, "qtype": "scale"},
    {"id": "HF1", "section": "🚩 紅旗題", "text": "最近胸口悶痛呼吸不順？", "options": HEALTH_FLAG, "qtype": "flag"},
